<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0c0c10">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="#ff5d7c"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="16dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动连接"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="前/后台自动扫描并连接已知设备"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/swAutoConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="悬浮窗记忆"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="记住悬浮窗位置和显示状态"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/swFloatMemory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="显示悬浮窗"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="在屏幕上显示实时心率"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/swFloatVisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="锁定悬浮窗"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="防止悬浮窗被误触拖动"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/swFloatLocked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnFloatStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="悬浮窗样式"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自定义悬浮窗外观"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tvFloatStyleName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#ff5d7c"
                android:textSize="14sp"/>
        </LinearLayout>
        <!-- 心率广播服务器（点击进入二级页面） -->
        <LinearLayout
            android:id="@+id/btnBroadcast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📡 心率广播"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="电脑实时查看心率"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
                <TextView
                    android:id="@+id/tvBroadcastStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点此管理"
                    android:textColor="#ff5d7c"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#675c62"
                android:textSize="18sp"/>
        </LinearLayout>

        <!-- MQTT 远程推送（内嵌配置） -->
        <LinearLayout
            android:id="@+id/mqttPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔗 MQTT 远程推送"
                        android:textColor="#e2c2cf"
                        android:textSize="15sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="跨网络推送心率，EMQX 国内节点免费"
                        android:textColor="#675c62"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                    <TextView
                        android:id="@+id/tvMqttStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏹ 未启动"
                        android:textColor="#ff5d7c"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/swMqttEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <!-- 配置详情（启用后展开） -->
            <LinearLayout
                android:id="@+id/mqttConfigBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设备标识"
                    android:textColor="#675c62"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/tvMqttTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#ff5d7c"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Broker"
                    android:textColor="#675c62"
                    android:textSize="11sp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <EditText
                        android:id="@+id/etMqttBroker"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="broker-cn.emqx.io"
                        android:textColor="#e2c2cf"
                        android:background="@drawable/glass_button"
                        android:padding="6dp"
                        android:textSize="13sp"
                        android:singleLine="true"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#675c62"
                        android:textSize="14sp"
                        android:paddingHorizontal="4dp"/>
                    <EditText
                        android:id="@+id/etMqttPort"
                        android:layout_width="70dp"
                        android:layout_height="36dp"
                        android:text="1883"
                        android:textColor="#e2c2cf"
                        android:background="@drawable/glass_button"
                        android:padding="6dp"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:inputType="number"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Topic"
                    android:textColor="#675c62"
                    android:textSize="11sp"/>
                <EditText
                    android:id="@+id/etMqttTopic"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="heart/rate"
                    android:textColor="#e2c2cf"
                    android:background="@drawable/glass_button"
                    android:padding="6dp"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="实际 Topic 自动带上设备标识"
                        android:textColor="#554a50"
                        android:textSize="10sp"
                        android:layout_marginBottom="6dp"/>
                    <Button
                        android:id="@+id/btnMqttTest"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:text="🔍 测试连接（检测 Broker 是否可达）"
                        android:textColor="#ffffff"
                        android:textSize="12sp"
                        android:background="@drawable/glass_button"
                        android:layout_marginBottom="8dp"/>
                <!-- 连接码 -->
                <LinearLayout
                    android:id="@+id/mqttCodeSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1a1a24"
                    android:padding="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="连接码（发给电脑端粘贴）"
                        android:textColor="#675c62"
                        android:textSize="10sp"/>
                    <TextView
                        android:id="@+id/tvMqttCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#ff5d7c"
                        android:textSize="11sp"
                        android:typeface="monospace"
                        android:padding="6dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">
                        <Button
                            android:id="@+id/btnCopyCode"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:text="📋 复制"
                            android:textColor="#ffffff"
                            android:textSize="12sp"
                            android:background="@drawable/glass_button"
                            android:layout_marginEnd="4dp"/>
                        <Button
                            android:id="@+id/btnShareCode"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:text="📤 分享"
                            android:textColor="#ffffff"
                            android:textSize="12sp"
                            android:background="@drawable/glass_button"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>
                <Button
                    android:id="@+id/btnMqttHelp"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:text="📖 MQTT 帮助（公共 Broker / 自建 / 阿里云）"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:background="@drawable/glass_button"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📖 使用帮助"
                android:textColor="#e2c2cf"
                android:textSize="15sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#675c62"
                android:textSize="18sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💬 联系作者 (QQ: 3544399875)"
                android:textColor="#e2c2cf"
                android:textSize="15sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#675c62"
                android:textSize="18sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnGitHub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🐙 GitHub 开源仓库"
                android:textColor="#e2c2cf"
                android:textSize="15sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#675c62"
                android:textSize="18sp"/>
        </LinearLayout>
        <!-- 检查更新 -->
        <LinearLayout
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⬇️ 去 Release 下载"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="从 GitHub 下载最新版本"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#675c62"
                android:textSize="18sp"/>
        </LinearLayout>
        <!-- 隐藏最近任务 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👻 隐藏最近任务"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App 不出现在最近任务列表中"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/swHideRecents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="心迹 v2.3"
            android:textColor="#3a3438"
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"/>
    </LinearLayout>
</ScrollView>