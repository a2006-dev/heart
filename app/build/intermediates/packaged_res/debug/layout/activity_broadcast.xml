<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0c0c10">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="@android:color/transparent"
                android:tint="#e2c2cf"
                android:layout_marginEnd="12dp"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📡 心率广播"
                android:textColor="#ff5d7c"
                android:textSize="22sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvServerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未运行"
                android:textColor="#675c62"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- 服务器开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="广播服务"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:id="@+id/tvNetworkInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WiFi: 未连接"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/swServer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 连接信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="连接信息"
                android:textColor="#e2c2cf"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:id="@+id/tvWifiName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WiFi: 获取中..."
                android:textColor="#e2c2cf"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>
            <TextView
                android:id="@+id/tvLocalIP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本机IP: 获取中..."
                android:textColor="#e2c2cf"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>
            <TextView
                android:id="@+id/tvAccessURL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="访问地址: 启动服务后显示"
                android:textColor="#ff5d7c"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- 局域网检测 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔍 局域网检测"
                    android:textColor="#e2c2cf"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvLanStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="检测中..."
                    android:textColor="#ff5d7c"
                    android:textSize="12sp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="同网段在线设备"
                android:textColor="#675c62"
                android:textSize="12sp"
                android:layout_marginBottom="6dp"/>
            <TextView
                android:id="@+id/tvDeviceList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="扫描中..."
                android:textColor="#e2c2cf"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- 自动推送 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📤 自动推送"
                        android:textColor="#e2c2cf"
                        android:textSize="15sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="每秒自动将心率推送到电脑"
                        android:textColor="#675c62"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/swAutoPush"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="电脑IP:端口"
                    android:textColor="#675c62"
                    android:textSize="13sp"
                    android:layout_marginEnd="8dp"/>
                <EditText
                    android:id="@+id/etPushTarget"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="192.168.1.5:9091"
                    android:text="192.168.1.5:9091"
                    android:textColor="#e2c2cf"
                    android:textColorHint="#3a3438"
                    android:textSize="13sp"
                    android:background="@drawable/glass_card"
                    android:padding="8dp"
                    android:gravity="center_vertical"
                    android:inputType="text|phone"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tvPushStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- 分享电脑端客户端 -->
        <LinearLayout
            android:id="@+id/btnSharePython"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💻 分享电脑端客户端"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选择 exe（双击即用）或 Python 脚本"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#675c62"
                android:textSize="18sp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
