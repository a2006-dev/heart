<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@android:color/transparent"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:layout_marginBottom="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- 设备图标 -->
    <TextView
        android:id="@+id/tvDeviceIcon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:gravity="center"
        android:text="@string/txt_auto_077"
        android:textSize="@dimen/font_headline"/>

    <!-- 设备名称和地址 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">
        <TextView
            android:id="@+id/tvDevName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/label"
            android:textSize="@dimen/font_subhead"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/txt_auto_078"/>
        <TextView
            android:id="@+id/tvDevAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/label_secondary"
            android:textSize="@dimen/font_caption"
            android:typeface="monospace"
            android:text="@string/txt_auto_079"/>
    </LinearLayout>

    <!-- 信号强度 -->
    <TextView
        android:id="@+id/tvDevRssi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/accent"
        android:textSize="@dimen/font_subhead"
        android:typeface="monospace"
        android:text="@string/txt_auto_080"
        android:drawableEnd="@drawable/ic_icon_signal"
        android:drawablePadding="4dp"
        android:gravity="center_vertical"
        android:layout_marginEnd="2dp"/>

    <!-- "⋮" 服务UUID详情按钮（广义搜索模式下可见） -->
    <TextView
        android:id="@+id/btnServiceDetail"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="@string/txt_auto_081"
        android:textColor="@color/label_secondary"
        android:textSize="20sp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"/>

</LinearLayout>