<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0c0c10">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="@null"
                android:tint="#e2c2cf"
                android:layout_marginEnd="12dp"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📡 心率广播"
                android:textColor="#ff5d7c"
                android:textSize="22sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvServerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未运行"
                android:textColor="#675c62"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- 服务器开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="广播服务"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:id="@+id/tvNetworkInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WiFi: 未连接"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/swServer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 连接信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="连接信息"
                android:textColor="#e2c2cf"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:id="@+id/tvWifiName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WiFi: 获取中..."
                android:textColor="#e2c2cf"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>
            <TextView
                android:id="@+id/tvLocalIP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本机IP: 获取中..."
                android:textColor="#e2c2cf"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>
            <TextView
                android:id="@+id/tvAccessURL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="访问地址: 启动服务后显示"
                android:textColor="#ff5d7c"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>
            <TextView
                android:id="@+id/tvQRCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="二维码: 启动服务后用同WiFi设备扫码打开"
                android:textColor="#675c62"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- 局域网检测 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔍 局域网检测"
                    android:textColor="#e2c2cf"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvLanStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="检测中..."
                    android:textColor="#ff5d7c"
                    android:textSize="12sp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="同网段在线设备"
                android:textColor="#675c62"
                android:textSize="12sp"
                android:layout_marginBottom="6dp"/>
            <TextView
                android:id="@+id/tvDeviceList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="扫描中..."
                android:textColor="#e2c2cf"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- 扫码连接 -->
        <LinearLayout
            android:id="@+id/btnScanConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷 扫码连接电脑"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="扫描电脑屏幕上的二维码，自动推送心率"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
                <TextView
                    android:id="@+id/tvScanTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未连接"
                    android:textColor="#ff5d7c"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷"
                android:textColor="#ff5d7c"
                android:textSize="18sp"/>
        </LinearLayout>

        <!-- 分享 Python 脚本 -->
        <LinearLayout
            android:id="@+id/btnSharePython"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐍 分享 Python 客户端"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="电脑上运行此脚本，自动接收并悬浮显示心率"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#675c62"
                android:textSize="18sp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
