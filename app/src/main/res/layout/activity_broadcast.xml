<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingTop="12dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/min_touch"
                android:layout_height="@dimen/min_touch"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/label"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/action_cancel" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/App.Title2"
                android:text="@string/txt_auto_001" />

            <TextView
                android:id="@+id/tvServerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/App.Footnote"
                android:text="@string/txt_auto_002" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/App.SectionHeader"
            android:layout_marginBottom="8dp"
            android:text="@string/txt_auto_003" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/App.Card"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/App.RowTitle"
                        android:text="@string/txt_auto_005" />

                    <TextView
                        android:id="@+id/tvNetworkInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/App.RowDesc"
                        android:text="@string/txt_auto_004" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swServer"
                    style="@style/App.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="@color/separator" />

            <TextView
                android:id="@+id/tvWifiName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/App.Value"
                android:layout_marginBottom="8dp"
                android:text="@string/txt_auto_006" />

            <TextView
                android:id="@+id/tvLocalIP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/App.Value"
                android:layout_marginBottom="8dp"
                android:text="@string/txt_auto_007" />

            <TextView
                android:id="@+id/tvAccessURL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="@dimen/font_subhead"
                android:text="@string/txt_auto_008" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/App.SectionHeader"
            android:layout_marginBottom="8dp"
            android:text="@string/txt_auto_009" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/App.Card"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/App.RowDesc"
                    android:text="@string/txt_auto_011" />

                <TextView
                    android:id="@+id/tvLanStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/font_footnote"
                    android:text="@string/txt_auto_010" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDeviceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/label"
                android:textSize="@dimen/font_footnote"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/txt_auto_012" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/App.SectionHeader"
            android:layout_marginBottom="8dp"
            android:text="@string/txt_auto_013" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/App.Card"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/App.RowTitle"
                        android:text="@string/txt_auto_014" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAutoPush"
                    style="@style/App.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/App.Footnote"
                    android:layout_marginEnd="10dp"
                    android:text="@string/txt_auto_015" />

                <EditText
                    android:id="@+id/etPushTarget"
                    style="@style/App.EditText"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="192.168.1.5:9091"
                    android:inputType="textUri"
                    android:text="@string/txt_auto_016" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPushStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/App.Caption"
                android:textColor="@color/success"
                android:layout_marginTop="10dp"
                android:text="" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSharePython"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/App.Card.Clickable"
            android:paddingTop="@dimen/card_padding"
            android:paddingBottom="@dimen/card_padding"
            android:paddingStart="@dimen/card_padding"
            android:paddingEnd="@dimen/card_padding"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/App.RowTitle"
                    android:text="@string/txt_auto_017" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/App.RowDesc"
                    android:text="@string/txt_auto_018" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/App.Chevron"
                android:layout_marginStart="12dp"
                android:text="@string/txt_auto_019" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>