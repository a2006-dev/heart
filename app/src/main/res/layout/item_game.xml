<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gameCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_ripple"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/card_padding"
    android:layout_marginBottom="@dimen/card_gap"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/gameIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/txt_auto_085"
        android:importantForAccessibility="no"
        android:src="@android:drawable/sym_def_app_icon" />

    <TextView
        android:id="@+id/gameName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/App.Headline"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <ImageButton
        android:id="@+id/btnRemove"
        android:layout_width="@dimen/min_touch"
        android:layout_height="@dimen/min_touch"
        android:src="@android:drawable/ic_menu_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="@color/label_tertiary"
        android:contentDescription="@string/txt_auto_086"
        android:importantForAccessibility="yes" />
</LinearLayout>