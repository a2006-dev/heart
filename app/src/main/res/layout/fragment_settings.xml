<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0c0c10">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_auto_038"
            android:textColor="#ff5d7c"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="16dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_039"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_040"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/swAutoConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_041"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_042"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/swFloatMemory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_043"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_044"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/swFloatVisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_045"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_046"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/swFloatLocked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnFloatStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_047"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_048"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tvFloatStyleName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#ff5d7c"
                android:textSize="14sp"/>
        </LinearLayout>
        <!-- 心率广播服务器（点击进入二级页面） -->
        <LinearLayout
            android:id="@+id/btnBroadcast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_icon_broadcast"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/txt_auto_001"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_049"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
                <TextView
                    android:id="@+id/tvBroadcastStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_050"
                    android:textColor="#ff5d7c"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_auto_019"
                android:textColor="#675c62"
                android:textSize="18sp"/>
        </LinearLayout>

        <!-- MQTT 远程推送（内嵌配置） -->
        <LinearLayout
            android:id="@+id/mqttPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_icon_link"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/txt_auto_051"
                        android:textColor="#e2c2cf"
                        android:textSize="15sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_auto_052"
                        android:textColor="#675c62"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                    <TextView
                        android:id="@+id/tvMqttStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_auto_053"
                        android:textColor="#ff5d7c"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/swMqttEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <!-- 配置详情（启用后展开） -->
            <LinearLayout
                android:id="@+id/mqttConfigBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_054"
                    android:textColor="#675c62"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/tvMqttTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#ff5d7c"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_055"
                    android:textColor="#675c62"
                    android:textSize="11sp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <EditText
                        android:id="@+id/etMqttBroker"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/txt_auto_056"
                        android:textColor="#e2c2cf"
                        android:background="@drawable/glass_button"
                        android:padding="6dp"
                        android:textSize="13sp"
                        android:singleLine="true"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_auto_057"
                        android:textColor="#675c62"
                        android:textSize="14sp"
                        android:paddingHorizontal="4dp"/>
                    <EditText
                        android:id="@+id/etMqttPort"
                        android:layout_width="70dp"
                        android:layout_height="36dp"
                        android:text="@string/txt_auto_058"
                        android:textColor="#e2c2cf"
                        android:background="@drawable/glass_button"
                        android:padding="6dp"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:inputType="number"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/txt_auto_059"
                        android:textColor="#675c62"
                        android:textSize="11sp"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swMqttTls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_060"
                    android:textColor="#675c62"
                    android:textSize="11sp"/>
                <EditText
                    android:id="@+id/etMqttTopic"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="@string/txt_auto_061"
                    android:textColor="#e2c2cf"
                    android:background="@drawable/glass_button"
                    android:padding="6dp"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_auto_062"
                        android:textColor="#554a50"
                        android:textSize="10sp"
                        android:layout_marginBottom="6dp"/>
                    <Button
                        android:id="@+id/btnMqttTest"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:drawableStart="@drawable/ic_icon_search"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/txt_auto_063"
                        android:textColor="#ffffff"
                        android:textSize="12sp"
                        android:background="@drawable/glass_button"
                        android:layout_marginBottom="8dp"/>
                <!-- 连接码 -->
                <LinearLayout
                    android:id="@+id/mqttCodeSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1a1a24"
                    android:padding="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_auto_064"
                        android:textColor="#675c62"
                        android:textSize="10sp"/>
                    <TextView
                        android:id="@+id/tvMqttCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#ff5d7c"
                        android:textSize="11sp"
                        android:typeface="monospace"
                        android:padding="6dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">
                        <Button
                            android:id="@+id/btnCopyCode"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_icon_clipboard"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/txt_auto_065"
                            android:textColor="#ffffff"
                            android:textSize="12sp"
                            android:background="@drawable/glass_button"
                            android:layout_marginEnd="4dp"/>
                        <Button
                            android:id="@+id/btnShareCode"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_icon_upload"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/txt_auto_066"
                            android:textColor="#ffffff"
                            android:textSize="12sp"
                            android:background="@drawable/glass_button"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>
                <Button
                    android:id="@+id/btnMqttHelp"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:drawableStart="@drawable/ic_icon_book"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/txt_auto_067"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:background="@drawable/glass_button"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_icon_book"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/txt_auto_068"
                android:textColor="#e2c2cf"
                android:textSize="15sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_auto_019"
                android:textColor="#675c62"
                android:textSize="18sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_icon_chat"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/txt_auto_069"
                android:textColor="#e2c2cf"
                android:textSize="15sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_auto_019"
                android:textColor="#675c62"
                android:textSize="18sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnGitHub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_icon_github"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/txt_auto_070"
                android:textColor="#e2c2cf"
                android:textSize="15sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_auto_019"
                android:textColor="#675c62"
                android:textSize="18sp"/>
        </LinearLayout>
        <!-- 检查更新 -->
        <LinearLayout
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_icon_download"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/txt_auto_071"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_072"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_auto_019"
                android:textColor="#675c62"
                android:textSize="18sp"/>
        </LinearLayout>
        <!-- 隐藏最近任务 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_icon_eye_off"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/txt_auto_073"
                    android:textColor="#e2c2cf"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_auto_074"
                    android:textColor="#675c62"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/swHideRecents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_auto_075"
            android:textColor="#3a3438"
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_icon_warning"
                android:drawablePadding="8dp"
                android:text="@string/txt_auto_076"
            android:textColor="#2a2428"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="2dp"
            android:paddingHorizontal="16dp"/>
    </LinearLayout>
</ScrollView>