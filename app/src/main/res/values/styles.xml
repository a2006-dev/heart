<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
    </style>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/label</item>
        <item name="colorOnSurfaceVariant">@color/label_secondary</item>
        <item name="colorOutline">@color/separator</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="App.LargeTitle" parent="">
        <item name="android:textSize">@dimen/font_large_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="App.Title2" parent="">
        <item name="android:textSize">@dimen/font_title2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="App.Headline" parent="">
        <item name="android:textSize">@dimen/font_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="App.Body" parent="">
        <item name="android:textSize">@dimen/font_body</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="App.Subhead" parent="">
        <item name="android:textSize">@dimen/font_subhead</item>
        <item name="android:textColor">@color/label_secondary</item>
    </style>
    <style name="App.Footnote" parent="">
        <item name="android:textSize">@dimen/font_footnote</item>
        <item name="android:textColor">@color/label_secondary</item>
    </style>
    <style name="App.Caption" parent="">
        <item name="android:textSize">@dimen/font_caption</item>
        <item name="android:textColor">@color/label_tertiary</item>
    </style>
    <style name="App.SectionHeader" parent="">
        <item name="android:textSize">@dimen/font_footnote</item>
        <item name="android:textColor">@color/label_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="App.Card" parent="">
        <item name="android:background">@drawable/card</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:layout_marginBottom">@dimen/card_gap</item>
        <item name="android:elevation">1dp</item>
    </style>
    <style name="App.Card.Clickable" parent="App.Card">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/card_ripple</item>
    </style>

    <style name="App.RowTitle" parent="">
        <item name="android:textSize">@dimen/font_body</item>
        <item name="android:textColor">@color/label</item>
    </style>
    <style name="App.RowDesc" parent="">
        <item name="android:textSize">@dimen/font_footnote</item>
        <item name="android:textColor">@color/label_secondary</item>
        <item name="android:layout_marginTop">3dp</item>
    </style>
    <style name="App.Value" parent="">
        <item name="android:textSize">@dimen/font_subhead</item>
        <item name="android:textColor">@color/label_secondary</item>
    </style>

    <style name="App.Button" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="cornerRadius">@dimen/radius_field</item>
        <item name="android:textSize">@dimen/font_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>
    <style name="App.Button.Secondary" parent="App.Button">
        <item name="backgroundTint">@color/fill</item>
        <item name="android:textColor">@color/accent</item>
    </style>
    <style name="App.Button.Danger" parent="App.Button">
        <item name="backgroundTint">@color/fill</item>
        <item name="android:textColor">@color/accent</item>
    </style>
    <style name="App.Button.Small" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_height">36dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textSize">@dimen/font_footnote</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="backgroundTint">@color/fill</item>
        <item name="android:textColor">@color/accent</item>
    </style>
    <style name="App.Button.Ghost" parent="App.Button.Small">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/label_secondary</item>
    </style>
    <style name="App.Button.Pill" parent="App.Button">
        <item name="android:layout_height">36dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:textSize">@dimen/font_footnote</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="App.IconButton" parent="">
        <item name="android:layout_width">@dimen/min_touch</item>
        <item name="android:layout_height">@dimen/min_touch</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/accent</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="App.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/fill_field</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textSize">@dimen/font_subhead</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:textColorHint">@color/label_tertiary</item>
        <item name="android:singleLine">true</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="App.Chevron" parent="">
        <item name="android:textSize">@dimen/font_body</item>
        <item name="android:textColor">@color/label_tertiary</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="App.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:trackTint">@color/switch_track</item>
        <item name="android:thumbTint">@color/switch_thumb</item>
    </style>

    <style name="App.EmptyTitle" parent="">
        <item name="android:textSize">@dimen/font_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="App.EmptyDesc" parent="">
        <item name="android:textSize">@dimen/font_subhead</item>
        <item name="android:textColor">@color/label_secondary</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
</resources>